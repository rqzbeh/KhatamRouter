{
  "name": "9router-app",
  "version": "0.5.111",
  "description": "KhatamRouter web dashboard",
  "private": true,
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": ">=1.4.4"
  },
  "scripts": {
    "dev": "bun --bun next dev --port 20127",
    "dev:webpack": "bun --bun next dev --webpack --port 20127",
    "build": "bun --bun next build --webpack",
    "postbuild": "bun scripts/copy-standalone-assets.mjs",
    "postbuild:bun": "bun scripts/copy-standalone-assets.mjs",
    "start": "bun custom-server.js --port 20127",
    "dev:bun": "bun --bun next dev --webpack --port 20127",
    "build:bun": "bun --bun next build --webpack",
    "start:bun": "bun ./.next/standalone/custom-server.js",
    "cli:pack": "bun --cwd cli run pack:cli",
    "cli:publish": "bun --cwd cli run publish:cli"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@monaco-editor/react": "^4.7.0",
    "@next/third-parties": "^16.2.9",
    "@node-saml/node-saml": "^5.1.0",
    "@xyflow/react": "^12.10.1",
    "bcryptjs": "^3.0.3",
    "chalk": "^6.0.1",
    "confbox": "^0.3.1",
    "enquirer": "^2.4.1",
    "express": "^5.2.1",
    "http-proxy-middleware": "^3.0.5",
    "ioredis": "^6.0.0",
    "jose": "^6.1.3",
    "marked": "^18.0.1",
    "material-symbols": "^0.48.0",
    "monaco-editor": "^0.57.0",
    "next": "^16.1.6",
    "node-forge": "^1.3.3",
    "node-machine-id": "^1.1.12",
    "open": "^11.0.0",
    "ora": "^9.1.0",
    "prop-types": "^15.8.1",
    "react": "19.3.1",
    "react-dom": "19.2.4",
    "react-is": "^16.13.1",
    "recharts": "^3.7.0",
    "selfsigned": "^5.5.0",
    "socks-proxy-agent": "^10.1.0",
    "undici": "^7.30.1",
    "uuid": "^14.0.3",
    "zustand": "^5.0.10"
