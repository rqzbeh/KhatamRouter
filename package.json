  "optionalDependencies": {
    "@aws-sdk/credential-providers": "^3.1156.0",
    "wreq-js": "3.2.0"
  },
  "comment_aws_sdk_credential_providers": "kept in optionalDependencies (npm still installs these by default) and imported lazily in shared/awsCredentials.js — only AWS Bedrock connections using profile/SSO mode need it; static accessKeyId/secretAccessKey connections never load it",
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "postcss": "^8.5.6",
    "tailwindcss": "^4",
    "typescript": "^6.0.3"
  }
