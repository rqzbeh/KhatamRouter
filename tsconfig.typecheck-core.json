{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowJs": true,
    "strict": false,
    "strictNullChecks": true,
    "noImplicitAny": false,
    "noEmit": true,
    "incremental": true,
    "tsBuildInfoFile": ".tsbuildinfo-typecheck-core"
  },
  "include": [
    "src/lib/**/*.ts",
    "src/lib/**/*.js",
    "src/shared/**/*.ts",
    "src/shared/**/*.js",
    "open-sse/**/*.ts",
    "open-sse/**/*.js"
  ],
  "exclude": [
    "node_modules",
    ".next",
    "dist",
    "coverage",
    "tests",
    "open-sse/node_modules"
  ]
}
