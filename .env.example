# KhatamRouter environment contract
# This file reflects actual runtime usage in the current codebase.

# Required
# Leave empty and the control plane generates a per-install secret under
# DATA_DIR/jwt-secret (mode 0600). Set an explicit value to keep sessions
# valid across hosts; never ship a placeholder value in production.
JWT_SECRET=
INITIAL_PASSWORD=change-me
DATA_DIR=/var/lib/khatamrouter

# Recommended runtime variables
# Dual-runtime port separation (Constitution Principle II):
#   DASHBOARD_PORT -> control plane / dashboard (Bun + Next.js standalone)
#   ENDPOINT_PORT  -> data plane / OpenAI-compatible gateway (Go runtime)
# PORT is kept as a backward-compatible alias for DASHBOARD_PORT.
PORT=20128
DASHBOARD_PORT=20128
ENDPOINT_PORT=20129
HOSTNAME=0.0.0.0
NODE_ENV=production

# Recommended security and ops variables
# Empty means the default HMAC salt is used — set a unique value in production.
API_KEY_SECRET=
MACHINE_ID_SALT=endpoint-proxy-salt
ENABLE_REQUEST_LOGS=false
OBSERVABILITY_ENABLED=true
AUTH_COOKIE_SECURE=false
REQUIRE_API_KEY=false

# Cloud sync variables
# Must point to this running instance so internal sync jobs can call /api/sync/cloud.
# Server-side preferred variables:
BASE_URL=http://localhost:20128
CLOUD_URL=https://9router.com
# Backward-compatible/public variables:
# NEXT_PUBLIC_* values are inlined at build time; keep them aligned with the
# control-plane and gateway listeners above.
NEXT_PUBLIC_BASE_URL=http://localhost:20128
NEXT_PUBLIC_ENDPOINT_URL=http://localhost:20129
NEXT_PUBLIC_CLOUD_URL=https://9router.com

# Redis (cluster-wide state sharing: rate limits, quotas, circuit breakers, pub/sub)
# Leave REDIS_URL empty to fall back to in-memory / SQLite operation.
REDIS_URL=
# Mandatory namespace prefix for every key and channel written to Redis.
REDIS_KEY_PREFIX=khatam:

# Optional outbound proxy variables for upstream provider calls
# Lowercase variants are also supported: http_proxy, https_proxy, all_proxy, no_proxy
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
# ALL_PROXY=socks5://127.0.0.1:7890
# NO_PROXY=localhost,127.0.0.1

# Optional SearXNG endpoint for the built-in unauthenticated web-search provider.
# SEARXNG_URL=http://searxng:8080/search

# Wave 5: Stealth and anti-ban suite (all default-off / false)
# Enable all stealth defenses globally:
# STEALTH_ALL=0
# Or enable individual capabilities:
# STEALTH_FINGERPRINTS=0
# STEALTH_HEADER_SCRUB=0
# STEALTH_TOOL_CLOAK=0
# STEALTH_ZERO_WIDTH=0
# STEALTH_STICKINESS=0
# Or enable CLI compatibility per provider (e.g. CLI_COMPAT_CLAUDE=1, CLI_COMPAT_CODEX=1, CLI_COMPAT_ALL=1)
# CLI_COMPAT_ALL=0

# Currently unused by application runtime (kept as reference)
# INSTANCE_NAME=khatamrouter
