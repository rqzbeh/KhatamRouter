{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowJs": true,
    "noEmit": true,
    "incremental": true,
    "tsBuildInfoFile": ".tsbuildinfo-typecheck-api"
  },
  "include": [
    "src/app/api/**/*.ts",
    "src/app/api/**/*.tsx",
    "src/app/api/**/*.js",
    "src/app/api/**/*.jsx"
  ],
  "exclude": [
    "node_modules",
    ".next",
    "dist",
    "coverage",
    "tests"
  ]
}
